<% layout('layouts/boilerplate') %>

<body>
  <div class="row justify-content-center my-5">
    <div class="col-xl-8 col-lg-9">
      <div class="card listing-show-card">
        <div class="row g-0">
          <div class="col-md-5">
            <% const imageUrl = listing.image?.url || listing.image || '/images/default-listing.jpg'; %>
            <img src="<%= imageUrl %>" class="img-fluid show-img" alt="<%= listing.title %>">
          </div>
          <div class="col-md-7">
            <div class="card-body py-4 px-4 px-md-5">
              <div class="d-flex justify-content-between align-items-start mb-4 gap-3 flex-column flex-xl-row">
                <div>
                  <h2 class="card-title mb-2"><%= listing.title %></h2>
                  <p class="text-muted mb-0"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
                </div>
                <div class="text-xl-end">
                  <div class="price-display">₹ <%= listing.price.toLocaleString('en-IN') %></div>
                  <p class="text-muted small mb-0">Price</p>
                </div>
              </div>
              <hr>
              <p class="text-secondary mb-4">Owned by <%= listing.owner?.username || 'Unknown' %></p>
              <h5 class="fw-semibold mb-3">Property Overview</h5>
              <p class="text-secondary mb-4"><%= listing.description %></p>
              <div class="row g-3">
                <div class="col-sm-6">
                  <p class="text-muted small mb-1">Country</p>
                  <p class="mb-0 fw-semibold"><%= listing.country %></p>
                </div>
                <div class="col-sm-6">
                  <p class="text-muted small mb-1">Location</p>
                  <p class="mb-0 fw-semibold"><%= listing.location %></p>
                </div>
              </div>
            </div>
            <div class="card-footer bg-white border-top-0 px-4 px-md-5 py-4 d-flex flex-column flex-sm-row justify-content-between gap-2">
              <a href="/listings" class="btn btn-outline-dark">
                <i class="fa-solid fa-arrow-left"></i> Back to Listings
              </a>
                <div class="d-flex gap-2 flex-wrap justify-content-end">
                  <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                  <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="m-0">
                    <button type="submit" class="btn btn-outline-danger">Delete</button>
                  </form>
                </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div>
    <% if (currentUser) { %>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" class="review-form needs-validation" novalidate>
        <div class="mb-3">
          <label class="form-label">Rating:</label>
          <fieldset class="starability-slot" aria-label="Rating">
            <legend class="visually-hidden">Rating</legend>
            <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
            <input type="radio" id="second-rate1" name="rating" value="1" />
            <label for="second-rate1" title="Terrible">1 star</label>
            <input type="radio" id="second-rate2" name="rating" value="2" />
            <label for="second-rate2" title="Not good">2 stars</label>
            <input type="radio" id="second-rate3" name="rating" value="3" />
            <label for="second-rate3" title="Average">3 stars</label>
            <input type="radio" id="second-rate4" name="rating" value="4" />
            <label for="second-rate4" title="Very good">4 stars</label>
            <input type="radio" id="second-rate5" name="rating" value="5" />
            <label for="second-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
        <div>
          <label for="comment" class="form-label">Comment:</label>
          <textarea id="comment" name="comment" rows="4" class="form-control" required></textarea>
        </div>
        <div>
          <button type="submit" class="btn btn-primary">Submit Review</button>
        </div>
      </form>
    <% } else { %>
      <p class="text-center text-muted">Please <a href="/login">log in</a> to leave a review.</p>
    <% } %>
  </div>
  <h1 class="text-center mt-5">Reviews</h1>
  <div class="row justify-content-center mt-4">
    <div class="col-xl-8 col-lg-9">
      <% if (listing.reviews.length === 0) { %>
        <p class="text-center text-muted">No reviews yet.</p>
      <% } else { %>
        <% listing.reviews.forEach(review => { %>
          <div class="card mb-3">
            <div class="card-body">
              <h5 class="card-title mb-0">
                <div class="starability-result d-inline-block align-middle" data-rating="<%= review.rating %>" aria-hidden="true"></div>
              </h5>
              <p class="text-muted small mb-2">Posted by <%= review.author?.username || 'Anonymous' %></p>
              <p class="card-text"><%= review.comment %></p>
            </div>
            <% if (currentUser && (review.author?.equals ? review.author.equals(currentUser._id) : review.author?._id?.toString() === currentUser._id?.toString()) || (listing.owner && listing.owner.equals ? listing.owner.equals(currentUser._id) : listing.owner?._id?.toString() === currentUser._id?.toString())) { %>
              <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="m-0">
                <button class="btn btn-danger delete-review-btn" data-review-id="<%= review._id %>">Delete Review</button>
              </form>
            <% } %>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</body>
